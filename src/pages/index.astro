      .contact-form { display: grid; gap: 15px; padding: 28px; border: 1px solid rgba(18, 34, 25, .15); background: rgba(248,250,246,.55); border-radius: 5px; }
      .contact-form label span { display: block; margin-bottom: 7px; font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: #728178; }
      .contact-form input, .contact-form textarea, .contact-form select { width: 100%; border: 0; border-bottom: 1px solid rgba(18, 34, 25, .18); border-radius: 0; padding: 8px 0 10px; background: transparent; color: var(--ink); outline: none; }
      .contact-form textarea { resize: vertical; min-height: 108px; }
      .contact-form input:focus, .contact-form textarea:focus, .contact-form select:focus { border-bottom-color: var(--ink); }
      .button--submit { border: 0; cursor: pointer; justify-self: start; }
      .form-note { margin: -2px 0 0; color: #728178; font-size: 10px; }

      .footer { padding: 52px 0 26px; background: var(--dark); color: #e7eee8; }
      .brand--footer { font-size: 17px; }
      .footer__top { display: flex; align-items: flex-end; justify-content: space-between; gap: 28px; }
      .footer p { margin: 8px 0 0; color: #7f9084; font-size: 11px; }
      .footer__socials { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
      .footer__socials a { border: 1px solid rgba(231, 238, 232, .15); border-radius: 999px; padding: 7px 11px; text-decoration: none; font-size: 10px; }
      .footer__bottom { display: flex; justify-content: space-between; gap: 18px; margin-top: 50px; padding-top: 15px; border-top: 1px solid rgba(231, 238, 232, .1); color: #65766b; font-size: 9px; text-transform: uppercase; letter-spacing: .08em; }

      .reveal, .reveal-on-scroll { opacity: 0; transform: translateY(22px); transition: opacity .8s ease, transform .8s cubic-bezier(.16,1,.3,1); }
      .reveal--delay-1 { transition-delay: .1s; }
      .reveal--delay-2 { transition-delay: .18s; }
      .reveal--delay-3 { transition-delay: .26s; }
      .hero .reveal { animation: heroIn .95s cubic-bezier(.16,1,.3,1) forwards; }
      .hero .reveal--delay-1 { animation-delay: .08s; }
      .hero .reveal--delay-2 { animation-delay: .16s; }
      .hero .reveal--delay-3 { animation-delay: .24s; }
      .reveal-on-scroll.is-visible { opacity: 1; transform: none; }
      @keyframes heroIn { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }

      .is-listening .wave-glow { animation: pulseGlow 2.4s ease-in-out infinite; }
      @keyframes pulseGlow { 0%,100% { opacity: .5; transform: scaleX(.96); } 50% { opacity: 1; transform: scaleX(1.02); } }

      @media (max-width: 1020px) {
        .nav__links { gap: 16px; }
        .projects-grid { grid-template-columns: repeat(3, 1fr); }
        .about { gap: 55px; }
        .awards-grid { grid-template-columns: repeat(2, 1fr); }
        .contact { gap: 55px; }
      }

      @media (max-width: 760px) {
        .shell { width: min(100% - 28px, 620px); }
        .nav__links { display: none; }
        .nav__cta { margin-left: auto; }
        .hero { min-height: 90svh; }
        .hero__content { padding: 88px 0 100px; }
        .nav { padding: 11px 16px; }
        .hero__title { font-size: clamp(64px, 16vw, 100px); }
        .hero__lede { font-size: 14px; max-width: 42ch; }
        .hero__actions { flex-direction: column; align-items: stretch; }
        .button { width: 100%; }
        .section { padding: 88px 0; }
        .section__head, .contact, .about { grid-template-columns: 1fr; gap: 34px; }
        .section__head { margin-bottom: 38px; }
        .section__intro { margin: 0; }
        .player { padding: 22px 16px; border-radius: 16px; }
        .track { grid-template-columns: 30px minmax(0, 1fr) 22px; gap: 10px; }
        .track__meta { display: none; }
        .projects-grid { grid-template-columns: repeat(2, 1fr); gap: 28px 12px; }
        .project h3 { font-size: 21px; }
        .about__media { max-width: 78vw; }
        .about__facts { grid-template-columns: 1fr; }
        .awards-grid { grid-template-columns: 1fr; }
        .award { min-height: 132px; }
        .contact-form { padding: 20px; }
        .footer__top, .footer__bottom { flex-direction: column; align-items: flex-start; }
        .footer__socials { justify-content: flex-start; }
      }

      @media (max-width: 480px) {
        .projects-grid { grid-template-columns: repeat(2, 1fr); gap: 22px 10px; }
        .project h3 { font-size: 17px; }
        .project p { font-size: 10px; }
        .hero__title { font-size: 65px; }
        .play { width: 54px; height: 54px; }
        .player h3 { font-size: 38px; }
        .about h2, .contact h2, .section__head h2 { font-size: 58px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
        .reveal, .reveal-on-scroll, .hero .reveal { opacity: 1; transform: none; }
      }
    </style>
  </body>
</html>
