---
import { getTracks, getProjects, getAwards } from '../lib/sanity';

export const prerender = false;

interface Award {
  slug: string;
  name: string;
  subtitle?: string;
  logo: string;
}

interface Project {
  slug: string;
  title: string;
  year: number;
  director?: string;
  type?: string;
  synopsis?: string;
  poster?: string;
  trailerUrl?: string;
}

interface Track {
  id: string;
  title: string;
  mood: string;
  instrumentation: string;
  src: string;
  project?: string;
}

const apiBase = import.meta.env.BACKEND_URL ?? '';
const publicAssetRoot = '/images/projects';

const assetUrl = (value?: string) => {
  if (!value) return '';
  if (/^(https?:)?\/\//i.test(value)) return value;
  if (value.startsWith('/')) return value;
  return `${publicAssetRoot}/${value}`;
};

// Public endpoint: returns published projects only.
// CRUD belongs in /admin and should authenticate against your real backend.
const fallbackProjects: Project[] = [
  { slug: 'spoke', title: 'Spoke', year: 2026, director: 'Regia Bogdan Darev', type: 'Cortometraggio', poster: assetUrl('Spoke-Poster-203x300.avif') },
  { slug: 'kid-with-a-movie-camera', title: 'Kid With a Movie Camera', year: 2026, director: 'Regia Micah Knapp', type: 'Documentario', poster: assetUrl('jsKWAMC_PosterMARZOLA-225x300.avif') },
  { slug: 'home-court', title: 'Home Court', year: 2026, director: 'Regia Rodrigo Ernandéz, Elpida Nikou', type: 'Cortometraggio', poster: assetUrl('HOMECOURT-poster-WIP-214x300.avif') },
  { slug: 'morphe', title: 'Morphé', year: 2026, director: 'Regia Luca Ferrara', type: 'Cortometraggio', poster: assetUrl('MORPHE-Poster-214x300.avif') },
  { slug: 'the-old-and-the-new', title: 'The Old and the New', year: 2026, director: 'Regia Luca Ferrara', type: 'Cortometraggio', poster: assetUrl('TOATN-Poster-201x300.avif') },
  { slug: 'as-the-sea', title: 'As the Sea', year: 2026, director: 'Regia Andrea Corazza', type: 'Cortometraggio', poster: assetUrl('AsTheSea-Poster-212x300.avif') },
  { slug: 'beyond-the-border', title: 'Beyond the Border', year: 2026, director: 'Regia Irena Daskalova', type: 'Cortometraggio', poster: assetUrl('BeyondTheBorderPOSTER-168x300.avif') },
  { slug: 'hidden-in-the-dark', title: 'Hidden in the Dark', year: 2025, director: 'Regia Christian Gato', type: 'Cortometraggio', poster: assetUrl('Poster-HITD-v01-214x300.avif') },
  { slug: 'el-mazarol', title: 'El Mazarol', year: 2025, director: 'Regia Juri Ferri', type: 'Cortometraggio', poster: assetUrl('el-mazarol-POSTER-0-1440x1800-1-240x300.avif') },
  { slug: 'the-ministry', title: 'The Ministry', year: 2025, director: 'Regia Aaron Ryan', type: 'Cortometraggio', poster: assetUrl('Poster-The-Ministry-203x300.avif') },
  { slug: 'il-sogno-disegnato', title: 'Il sogno disegnato', year: 2025, director: 'Regia Andrea Corazza', type: 'Cortometraggio', poster: assetUrl('Il-Sogno-Disegnato-poster-212x300.avif') },
  { slug: 'the-fox-and-the-crow', title: 'The Fox and the Crow', year: 2025, director: 'Regia Shakila Bizimana', type: 'Cortometraggio', poster: assetUrl('POSTER-THE-FOX-THE-CROW-1-212x300.avif') },
  { slug: 'sans-dieu', title: 'Sans Dieu', year: 2024, director: 'Regia Alessandro Rocca', type: 'Cortometraggio', poster: assetUrl('poster_SansDieu-200x300.avif') },
  { slug: 'centipede', title: 'Centipede', year: 2022, director: 'Regia Vera Ivanova', type: 'Cortometraggio', poster: assetUrl('Centipede-poster-212x300.jpeg') },
];

// I brani vivono ormai solo in Sanity: niente più placeholder qui, per
// evitare doppioni quando aggiungi un brano in Sanity con un titolo già
// presente in questa lista.
const fallbackTracks: Track[] = [];

const fallbackAwards: Award[] = [
  { slug: 'venice-iff', name: 'Venice IFF', subtitle: 'Official selection / festival presence', logo: assetUrl('1722509711-66ab698fddfbb-venice-iff-2024-logo-png-300x168.avif') },
  { slug: 'tampere', name: 'Tampere', subtitle: 'Film Festival', logo: assetUrl('TampereLogo-300x160.avif') },
  { slug: 'isfmf-2025', name: 'ISFMF', subtitle: 'Nomination · 2025', logo: assetUrl('ISFMF_2025_Top.avif') },
  { slug: 'apulia-top10', name: 'Apulia', subtitle: 'Top 10 · 2022', logo: assetUrl('TOP-10-Apulia-150x150.png') },
];

let projects = fallbackProjects;
let tracks = fallbackTracks;
let awards = fallbackAwards;
try {
  const [t, p, a] = await Promise.all([getTracks(), getProjects(), getAwards()]);
  const sanitySlugs = new Set(p.map((x) => x.slug));
  const sanityIds = new Set(t.map((x) => x.id));
  const sanityAwardSlugs = new Set(a.map((x) => x.slug));
  projects = [...p, ...fallbackProjects.filter((x) => !sanitySlugs.has(x.slug))];
  tracks = [...t, ...fallbackTracks.filter((x) => !sanityIds.has(x.id))];
  awards = [...a, ...fallbackAwards.filter((x) => !sanityAwardSlugs.has(x.slug))];
} catch (e) {
  console.error('Sanity non raggiungibile, uso i dati di riserva', e);
}

if (apiBase) {
  try {
    const response = await fetch(`${apiBase}/api/projects?published=true`, { headers: { Accept: 'application/json' } });
    if (response.ok) {
      const data = await response.json();
      if (Array.isArray(data?.projects)) projects = data.projects.map((project: Project) => ({
        ...project,
        poster: assetUrl(project.poster),
      }));
      if (Array.isArray(data?.tracks)) tracks = data.tracks.map((track: Track) => ({
        ...track,
        src: track.src ? assetUrl(track.src) : '',
      }));
    }
  } catch {
    // Keep the curated fallback so the site still renders if the CMS/API is offline.
  }
}

const projectTypes = Array.from(new Set(projects.map((project) => project.type).filter(Boolean)));
const types = ['Tutti', ...projectTypes];
const typeCounts: Record<string, number> = { Tutti: projects.length };
for (const type of projectTypes) {
  typeCounts[type] = projects.filter((p) => p.type === type).length;
}

const socials = [
  ['Instagram', 'https://www.instagram.com/francesco_marzola/'],
  ['Facebook', 'https://www.facebook.com/Francesco-Marzola-Music-107477305135625'],
  ['IMDb', 'https://www.imdb.com/name/nm13494062/'],
  ['Spotify', 'https://open.spotify.com/artist/19x9qN4lYMAPYatRJ1Nm0P'],
  ['YouTube', 'https://www.youtube.com/channel/UCf5Qaoq04gfPUd8-Goy0RUw'],
];
---

