    <script define:vars={{ tracks }}>
      const TRACKS = tracks;
      const root = document.documentElement;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const $ = (selector) => document.querySelector(selector);
      const $$ = (selector) => [...document.querySelectorAll(selector)];

      // ------------------------------
      // Parallax / motion
      // ------------------------------
      const parallaxTargets = $$('[data-parallax]');
      let latestScrollY = window.scrollY;
      let ticking = false;

      const updateParallax = () => {
        ticking = false;
        if (reduceMotion) return;
        document.querySelectorAll('.hero__orb').forEach((el, index) => {
          const speed = index === 0 ? 0.08 : -0.045;
          el.style.transform = `translate3d(0, ${latestScrollY * speed}px, 0)`;
        });
        parallaxTargets.forEach((el) => {
          const speed = Number(el.dataset.parallax || 0.1);
          const rect = el.getBoundingClientRect();
          const shift = (window.innerHeight * 0.5 - rect.top) * speed;
          el.style.transform = `translate3d(0, ${shift}px, 0)`;
        });
      };

      window.addEventListener('scroll', () => {
        latestScrollY = window.scrollY;
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateParallax);
        }
      }, { passive: true });

      // ------------------------------
      // Reveal on scroll
      // ------------------------------
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      $$('.reveal-on-scroll').forEach((el) => revealObserver.observe(el));

      // ------------------------------
      // Audio player + real MP3 waveform
      // ------------------------------
      // I file audio ospitati su Sanity passano dal nostro proxy
      // (stesso dominio), così evitiamo il blocco CORS sia per la
      // riproduzione sia per la lettura della waveform reale.
      const resolvePlayableSrc = (src) => {
        if (!src) return '';
        if (src.includes('cdn.sanity.io')) return `/api/audio-proxy?src=${encodeURIComponent(src)}`;
        return src;
      };

      const audio = $('#audio');
      const canvas = $('#waveform');
      const ctx = canvas.getContext('2d');
      const playButton = $('#play-button');
      const titleEl = $('#track-title');
      const metaEl = $('#track-meta');
      const currentEl = $('#current-time');
      const durationEl = $('#duration');
      const statusEl = $('#track-status');
      const trackButtons = $$('.track');
      let currentTrack = 0;
      let peaks = [];
      let audioBuffer = null;
      let resizeObserver;

      const formatTime = (value) => {
        if (!Number.isFinite(value)) return '0:00';
        const min = Math.floor(value / 60);
        const sec = Math.floor(value % 60).toString().padStart(2, '0');
        return `${min}:${sec}`;
      };

      const getColors = () => {
        const styles = getComputedStyle(root);
        return {
          wave: styles.getPropertyValue('--wave').trim(),
          accent: styles.getPropertyValue('--accent').trim(),
          line: styles.getPropertyValue('--line').trim(),
        };
      };

      const resizeCanvas = () => {
        const rect = canvas.getBoundingClientRect();
        const ratio = Math.max(1, window.devicePixelRatio || 1);
        canvas.width = Math.floor(rect.width * ratio);
        canvas.height = Math.floor(rect.height * ratio);
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
        drawWaveform();
      };

      const resamplePeaks = (buffer, count = 180) => {
        const channels = buffer.numberOfChannels;
        const length = buffer.length;
        const blockSize = Math.max(1, Math.floor(length / count));
        const result = new Array(count).fill(0);

        for (let i = 0; i < count; i++) {
          const start = i * blockSize;
          const end = Math.min(length, start + blockSize);
          let peak = 0;
          for (let channel = 0; channel < channels; channel++) {
            const data = buffer.getChannelData(channel);
            for (let j = start; j < end; j += Math.max(1, Math.floor((end - start) / 80))) {
              peak = Math.max(peak, Math.abs(data[j]));
            }
          }
          const envelope = 0.18 + 0.82 * Math.min(1, peak * 1.35);
          result[i] = envelope;
        }
        return result;
      };

      const decodeTrack = async (track) => {
        try {
          const response = await fetch(resolvePlayableSrc(track.src), { cache: 'force-cache' });
          if (!response.ok) throw new Error(`Audio fetch failed: ${response.status}`);
          const arrayBuffer = await response.arrayBuffer();
          const AudioContextCtor = window.AudioContext || window.webkitAudioContext;
          const audioContext = new AudioContextCtor();
          audioBuffer = await audioContext.decodeAudioData(arrayBuffer.slice(0));
          peaks = resamplePeaks(audioBuffer, Math.min(220, Math.max(120, Math.floor(audioBuffer.duration * 1.4))));
          durationEl.textContent = formatTime(audioBuffer.duration);
          drawWaveform();
          await audioContext.close();
        } catch (error) {
          // The player still works if decoding is blocked by CORS or browser policy.
          peaks = [];
          drawWaveform();
        }
      };

      const drawWaveform = () => {
        if (!canvas) return;
        const width = canvas.clientWidth;
        const height = canvas.clientHeight;
        if (!width || !height) return;
        const { wave, accent, line } = getColors();
        ctx.clearRect(0, 0, width, height);

        ctx.strokeStyle = line;
        ctx.globalAlpha = 0.7;
        ctx.beginPath();
        ctx.moveTo(0, height / 2);
        ctx.lineTo(width, height / 2);
        ctx.stroke();
        ctx.globalAlpha = 1;

        if (!peaks.length) {
          ctx.strokeStyle = wave;
          ctx.globalAlpha = 0.45;
          ctx.beginPath();
          ctx.moveTo(0, height / 2);
          ctx.lineTo(width, height / 2);
          ctx.stroke();
          ctx.globalAlpha = 1;
          return;
        }

        const source = peaks;
        const progress = audio.duration ? audio.currentTime / audio.duration : 0;
        const gap = 2;
        const barWidth = Math.max(1.3, (width - gap * source.length) / source.length);

        source.forEach((value, index) => {
          const x = index * (barWidth + gap);
          const barHeight = Math.max(4, value * height * 0.9);
          ctx.fillStyle = index / source.length <= progress ? accent : wave;
          ctx.beginPath();
          ctx.roundRect(x, (height - barHeight) / 2, barWidth, barHeight, Math.min(2, barWidth / 2));
          ctx.fill();
        });
      };

      const loadTrack = async (index, autoplay = false) => {
        currentTrack = index;
        const track = TRACKS[index];
        if (!track) return;
        audio.pause();
        audio.removeAttribute('src');
        audio.load();
        audioBuffer = null;
        peaks = [];
        titleEl.textContent = track.title;
        metaEl.textContent = `${track.mood} · ${track.instrumentation}`;
        currentEl.textContent = '0:00';
        durationEl.textContent = '0:00';
        statusEl.textContent = track.src ? 'MP3 waveform from source audio' : 'Add the real MP3 URL/file in the backend to enable playback';
        statusEl.hidden = Boolean(track.src);
        trackButtons.forEach((button, i) => button.classList.toggle('is-active', i === index));
        if (!track.src) { drawWaveform(); return; }
        audio.src = resolvePlayableSrc(track.src);
        audio.load();
        await decodeTrack(track);
        if (autoplay) {
          try { await audio.play(); } catch {}
        }
      };

      playButton.addEventListener('click', async () => {
        if (!audio.src) { statusEl.hidden = false; return; }
        if (audio.paused) {
          try { await audio.play(); } catch {}
        } else {
          audio.pause();
        }
      });

      audio.addEventListener('play', () => {
        playButton.textContent = '❚❚';
        playButton.setAttribute('aria-label', 'Pausa');
        root.classList.add('is-listening');
      });
      audio.addEventListener('pause', () => {
        playButton.textContent = '▶';
        playButton.setAttribute('aria-label', 'Riproduci');
        root.classList.remove('is-listening');
      });
      audio.addEventListener('ended', () => loadTrack((currentTrack + 1) % TRACKS.length, true));
      audio.addEventListener('timeupdate', () => {
        currentEl.textContent = formatTime(audio.currentTime);
        drawWaveform();
        canvas.setAttribute('aria-valuenow', String(Math.round((audio.currentTime / (audio.duration || 1)) * 100)));
      });
      audio.addEventListener('loadedmetadata', () => {
        durationEl.textContent = formatTime(audio.duration);
        drawWaveform();
      });

      const seek = (clientX) => {
        const rect = canvas.getBoundingClientRect();
        const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
        if (Number.isFinite(audio.duration)) audio.currentTime = ratio * audio.duration;
      };

      canvas.addEventListener('click', (event) => seek(event.clientX));
      canvas.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') { audio.currentTime = Math.min(audio.duration || 0, audio.currentTime + 5); event.preventDefault(); }
        if (event.key === 'ArrowLeft') { audio.currentTime = Math.max(0, audio.currentTime - 5); event.preventDefault(); }
        if (event.key === 'Home') { audio.currentTime = 0; event.preventDefault(); }
        if (event.key === 'End') { audio.currentTime = audio.duration || 0; event.preventDefault(); }
      });

      trackButtons.forEach((button, index) => {
        button.addEventListener('click', () => loadTrack(index, true));
      });

      resizeObserver = new ResizeObserver(resizeCanvas);
      resizeObserver.observe(canvas);
      window.addEventListener('resize', resizeCanvas);
      loadTrack(0);
      resizeCanvas();

      // ------------------------------
      // Project filters + "mostra altri" progressivo
      // ------------------------------
      const projectCards = $$('.project');
      const filterButtons = $$('.filter');
      const projectsGrid = $('#projects-grid');
      const moreWrap = $('#projects-more');
      const moreBtn = $('#projects-more-btn');
      const moreCount = $('#projects-more-count');
      const INITIAL_VISIBLE = 12;
      const matchesType = (projectType, filter) => filter === 'Tutti' || projectType === filter;

      let currentFilter = 'Tutti';
      let expanded = false;

      const currentColumnCount = () => {
        const value = getComputedStyle(projectsGrid).gridTemplateColumns;
        return value.split(' ').filter(Boolean).length || 1;
      };

      const renderVisibility = () => {
        const matching = projectCards.filter((card) => matchesType(card.dataset.projectType, currentFilter));
        const nonMatching = projectCards.filter((card) => !matchesType(card.dataset.projectType, currentFilter));

        nonMatching.forEach((card) => { card.hidden = true; card.classList.remove('is-teaser'); });

        const teaserSize = expanded ? 0 : currentColumnCount();
        const hiddenCount = Math.max(0, matching.length - INITIAL_VISIBLE - teaserSize);

        matching.forEach((card, i) => {
          if (expanded || i < INITIAL_VISIBLE) {
            card.hidden = false;
            card.classList.remove('is-teaser');
          } else if (i < INITIAL_VISIBLE + teaserSize) {
            card.hidden = false;
            card.classList.add('is-teaser');
          } else {
            card.hidden = true;
            card.classList.remove('is-teaser');
          }
        });

        const notFullyVisible = matching.length - INITIAL_VISIBLE;
        if (!expanded && notFullyVisible > 0) {
          moreWrap.hidden = false;
          moreCount.textContent = `(${notFullyVisible})`;
        } else {
          moreWrap.hidden = true;
        }
      };

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          currentFilter = button.dataset.type;
          expanded = false;
          filterButtons.forEach((b) => b.classList.toggle('is-selected', b === button));
          renderVisibility();
        });
      });

      moreBtn.addEventListener('click', () => {
        expanded = true;
        renderVisibility();
      });

      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(renderVisibility, 150);
      });

      renderVisibility();

      // ------------------------------
      // Magnetic CTA effect
      // ------------------------------
      if (!reduceMotion) {
        $$('.button--solid, .nav__cta').forEach((button) => {
          button.addEventListener('pointermove', (event) => {
            const rect = button.getBoundingClientRect();
            const x = (event.clientX - rect.left - rect.width / 2) * 0.08;
            const y = (event.clientY - rect.top - rect.height / 2) * 0.08;
            button.style.transform = `translate(${x}px, ${y}px)`;
          });
          button.addEventListener('pointerleave', () => { button.style.transform = ''; });
        });
      }

      updateParallax();
    </script>

